{
  "expo": {
    "name": "Centavo",
    "slug": "centavo-mobile",
    "scheme": "centavo",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": { "supportsTablet": false },
    "android": {
      "package": "br.com.caioqc.centavo",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#2F54EB"
      },
      "permissions": ["android.permission.USE_BIOMETRIC", "android.permission.USE_FINGERPRINT"]
    },
    "web": { "favicon": "./assets/favicon.png" },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F3F5F9",
          "dark": { "image": "./assets/splash-icon.png", "backgroundColor": "#0F1218" }
        }
      ],
      ["expo-local-authentication", { "faceIDPermission": "O Centavo usa o Face ID para abrir o app." }]
    ],
    "extra": {
      "router": { "asyncRoutes": { "web": true } },
      "eas": { "projectId": "ee6eae03-b8a1-47e2-b8e2-dec928163e85" }
    },
    "owner": "caioqc"
  }
}
